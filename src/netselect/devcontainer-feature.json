{
    "name": "netselect",
    "id": "netselect",
    "version": "2.0.0",
    "description": "Points apt at a nearby mirror: netselect-apt on Debian, apt's mirror:// method on Ubuntu, or a mirror you choose. Use `overrideFeatureInstallOrder` to ensure it runs first.",
    "documentationURL": "https://github.com/hastarin/devcontainers-feature-netselect/tree/main/src/netselect",
    "licenseURL": "https://github.com/hastarin/devcontainers-feature-netselect/blob/main/LICENSE",
    "keywords": [
        "apt",
        "mirror",
        "netselect",
        "debian",
        "ubuntu"
    ],
    "options": {
        "mirror": {
            "type": "string",
            "default": "",
            "description": "Archive URL to use instead of auto-selecting one, e.g. http://ftp.au.debian.org/debian or http://apt-cacher:3142/deb.debian.org/debian. Security archives and *-security suites are not changed."
        },
        "country": {
            "type": "string",
            "proposals": [
                "am",
                "at",
                "au",
                "be",
                "bg",
                "br",
                "by",
                "ca",
                "ch",
                "cl",
                "cn",
                "cz",
                "de",
                "dk",
                "es",
                "fi",
                "fr",
                "gb",
                "hk",
                "hr",
                "hu",
                "is",
                "it",
                "jp",
                "kr",
                "lt",
                "md",
                "nl",
                "no",
                "nz",
                "pl",
                "pt",
                "ru",
                "se",
                "si",
                "sk",
                "tw",
                "us"
            ],
            "default": "default",
            "description": "Debian only: ISO country code; netselect-apt only considers mirrors in that country. Ignored when 'mirror' is set."
        }
    }
}
